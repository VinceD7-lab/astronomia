---
import { parties, animations, outils, lien } from '../data/cours';
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const index = [
  ...parties.flatMap((p) => p.chapitres.map((c) => ({ t: c.titre, d: `Partie ${p.n} · ${p.titre}${c.sous ? ' · ' + c.sous : ''}`, u: lien(c.chemin).href }))),
  ...animations.map((a) => ({ t: cap(a.titre), d: `Animation · partie ${a.partie}`, u: lien(a.chemin).href })),
  ...outils.map((o) => ({ t: o.titre, d: 'Outil', u: lien(o.chemin).href })),
];
---
<dialog id="recherche" aria-label="Rechercher dans le cours">
  <div class="dlg-tete">
    <label class="rech"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><span class="visually-hidden">Rechercher un chapitre, une animation, un outil</span><input id="q" type="text" role="searchbox" enterkeyhint="search" placeholder="Pulsars, marées, calendrier…" autocomplete="off" spellcheck="false" /></label>
    <button class="bouton" type="button" data-fermer>Fermer</button>
  </div>
  <div class="dlg-corps"><ul class="resultats" id="resultats"></ul></div>
  <script id="index-recherche" type="application/json" set:html={JSON.stringify(index).replace(/</g, '\\u003c')} />
</dialog>
