---
import { url } from '../lib/url';
const accueil = url('/');
---
<header class="barre">
  <div class="wrap">
    <a class="marque" href={accueil} aria-label="Astronomia, accueil">
      <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="1.4" opacity=".45"/><ellipse cx="16" cy="16" rx="14" ry="5" fill="none" stroke="var(--oiii)" stroke-width="1.4" transform="rotate(-24 16 16)"/><circle cx="16" cy="16" r="3.4" fill="var(--sodium)"/></svg>
      astronomia
    </a>
    <nav class="nav" aria-label="Principales rubriques">
      <a href={accueil + '#livre-parties'}>Le cours</a>
      <a href={accueil + '#animations'}>Animations</a>
      <a href={accueil + '#outils'}>Outils</a>
      <a href="https://astronomia.fr/7eme_partie/lexique.php">Lexique</a>
    </nav>
    <button class="bouton" type="button" id="ouvrirSommaire" aria-haspopup="dialog"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg><span class="txt">Sommaire</span></button>
    <button class="bouton" type="button" id="ouvrirRecherche" aria-haspopup="dialog" aria-label="Rechercher"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><span class="txt">Chercher</span><kbd>/</kbd></button>
    <button class="bouton" type="button" id="theme" aria-label="Changer de thème"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></svg></button>
  </div>
  <div class="progression" id="progression" aria-hidden="true"></div>
</header>
