---
/**
 * Distance d’une Céphéide : la période donne la magnitude absolue (loi de Leavitt),
 * la comparaison avec la magnitude apparente donne la distance (module de distance).
 */
interface Props { periode?: number; m?: number }
const { periode = 5.366, m = 3.95 } = Astro.props;
// repère du graphique : log P de 0 à 2 (1 à 100 jours), M de −1 (bas) à −8 (haut)
const X = (lp: number) => 60 + 500 * (lp / 2);
const Y = (M: number) => 20 + 220 * ((M + 1) / -7);
const droite = `M${X(0)} ${Y(-2.43 * (0 - 1) - 4.05)}L${X(2)} ${Y(-2.43 * (2 - 1) - 4.05)}`;
const jours = [1, 2, 5, 10, 20, 50, 100];
---
<div class="sim cepheide" data-cepheide data-pagefind-ignore data-periode={periode} data-m={m}>
  <svg viewBox="0 0 600 290" role="img" aria-label="Relation période-luminosité des Céphéides : plus la période est longue, plus l’étoile est lumineuse.">
    <rect x="60" y="20" width="500" height="220" class="cadre" />
    {jours.map((j) => (
      <g>
        <line x1={X(Math.log10(j))} x2={X(Math.log10(j))} y1="20" y2="240" class="grille" />
        <text x={X(Math.log10(j))} y="258" text-anchor="middle" class="etiq doux">{j}</text>
      </g>
    ))}
    {[-2, -3, -4, -5, -6, -7].map((M) => (
      <g>
        <line x1="60" x2="560" y1={Y(M)} y2={Y(M)} class="grille" />
        <text x="52" y={Y(M) + 4} text-anchor="end" class="etiq doux">{M}</text>
      </g>
    ))}
    <text x="310" y="282" text-anchor="middle" class="etiq doux">période (jours, échelle logarithmique)</text>
    <text x="14" y="130" class="etiq doux" transform="rotate(-90 14 130)" text-anchor="middle">magnitude absolue M</text>
    <path d={droite} class="loi" />
    <line data-guide-x class="guide" /><line data-guide-y class="guide" />
    <circle data-point r="7" class="point" />
  </svg>
  <div class="controls">
    <label>Période P <input data-p type="range" min="0" max="2" step="0.001" /><output data-p-out></output></label>
    <label>Magnitude apparente moyenne m <input data-m type="range" min="0" max="25" step="0.01" /><output data-m-out></output></label>
    <div class="boutons">
      <button type="button" data-preset="5.366,3.95">δ Céphée</button>
      <button type="button" data-preset="10,14.6">Céphéide du Grand Nuage de Magellan</button>
      <button type="button" data-preset="31.4,19.1">V1 dans Andromède (Hubble, 1923)</button>
    </div>
  </div>
  <div class="readout" aria-live="polite">
    <div><b data-res-M>–</b><span>magnitude absolue M (1 → 2)</span></div>
    <div><b data-res-mod>–</b><span>module m − M</span></div>
    <div><b data-res-d>–</b><span>distance (3 → 4)</span></div>
    <div><b data-res-al>–</b><span>en années-lumière</span></div>
  </div>
  <p class="legende">Loi de Leavitt en lumière visible : M = −2,43 (log P − 1) − 4,05. L’absorption par la poussière interstellaire, négligée ici, fait paraître les étoiles un peu plus lointaines.</p>
</div>

<style>
  .cepheide .cadre{fill:var(--nuit);stroke:var(--trait)}
  .cepheide .grille{stroke:var(--trait);stroke-width:1}
  .cepheide .loi{stroke:var(--oiii);stroke-width:2.5;fill:none}
  .cepheide .guide{stroke:var(--sodium);stroke-width:1;stroke-dasharray:4 3}
  .cepheide .point{fill:var(--sodium);stroke:var(--nuit);stroke-width:1.5}
  .cepheide .etiq{font-family:var(--mono);font-size:12px;fill:var(--texte)}
  .cepheide .etiq.doux{fill:var(--doux)}
</style>

<script>
  import { magnitudeCepheide, distanceModule, PC_AL } from '../../lib/distances';

  const fmt = (x: number, d: number) => x.toLocaleString('fr-FR', { minimumFractionDigits: d, maximumFractionDigits: d });
  const X = (lp: number) => 60 + 500 * (lp / 2);
  const Y = (M: number) => 20 + 220 * ((M + 1) / -7);
  const distance = (pc: number) => (pc < 1000 ? `${fmt(pc, 0)} pc` : pc < 1e6 ? `${fmt(pc / 1000, 1)} kpc` : `${fmt(pc / 1e6, 2)} Mpc`);
  const al = (pc: number) => {
    const x = pc * PC_AL;
    return x < 1e6 ? `${fmt(x, 0)} al` : `${fmt(x / 1e6, 2)} millions d’al`;
  };

  document.querySelectorAll<HTMLElement>('[data-cepheide]').forEach((root) => {
    const q = <T extends Element>(s: string) => root.querySelector(s) as T;
    const att = (s: string, a: Record<string, number | string>) => { const el = q<SVGElement>(s); for (const [k, v] of Object.entries(a)) el.setAttribute(k, String(v)); };
    const inP = q<HTMLInputElement>('[data-p]'), inM = q<HTMLInputElement>('[data-m]');
    inP.value = String(Math.log10(+root.dataset.periode!)); inM.value = root.dataset.m!;

    function calcule() {
      const P = 10 ** +inP.value, m = +inM.value, M = magnitudeCepheide(P), d = distanceModule(m, M);
      att('[data-point]', { cx: X(+inP.value), cy: Y(M) });
      att('[data-guide-x]', { x1: X(+inP.value), x2: X(+inP.value), y1: 240, y2: Y(M) });
      att('[data-guide-y]', { x1: 60, x2: X(+inP.value), y1: Y(M), y2: Y(M) });
      q('[data-p-out]').textContent = `${fmt(P, P < 10 ? 2 : 1)} jours`;
      q('[data-m-out]').textContent = fmt(m, 2);
      q('[data-res-M]').textContent = fmt(M, 2);
      q('[data-res-mod]').textContent = fmt(m - M, 2);
      q('[data-res-d]').textContent = distance(d);
      q('[data-res-al]').textContent = al(d);
    }
    inP.addEventListener('input', calcule); inM.addEventListener('input', calcule);
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => {
      const [p, m] = b.dataset.preset!.split(',').map(Number);
      inP.value = String(Math.log10(p)); inM.value = String(m); calcule();
    }));
    calcule();
  });
</script>
