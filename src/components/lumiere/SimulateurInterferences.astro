---
/**
 * Interférences : la somme de deux sinusoïdes A et B. On règle la phase, l’amplitude et la fréquence
 * de B, et l’on voit le résultat R = A + B. Remplace l’animation du site d’origine.
 */
---
<div class="sim interferences" data-interferences data-pagefind-ignore>
  <svg viewBox="0 0 600 300" role="img" aria-label="À gauche, deux sinusoïdes A et B ; à droite, leur somme R.">
    <g data-cadres></g>
    <path data-a class="courbe a" d="" />
    <path data-b class="courbe b" d="" />
    <path data-r class="courbe r" d="" />
    <text x="20" y="22" class="etiq a">A : y = sin x</text>
    <text x="20" y="168" class="etiq b" data-b-txt>B</text>
    <text x="320" y="22" class="etiq r">R = A + B</text>
  </svg>
  <div class="controls">
    <label>Phase φ <input data-phase type="range" min="0" max="360" step="1" value="0" /><output data-phase-out></output></label>
    <label>Amplitude a <input data-amp type="range" min="0" max="1" step="0.01" value="0" /><output data-amp-out></output></label>
    <label>Fréquence <input data-freq type="range" min="0.5" max="5" step="0.05" value="1" /><output data-freq-out></output></label>
    <div class="boutons">
      <button type="button" data-preset="0,1,1">Ondes en phase</button>
      <button type="button" data-preset="180,1,1">Opposition de phase</button>
      <button type="button" data-preset="0,0.33,3">Presque un créneau</button>
    </div>
  </div>
</div>

<style>
  .interferences path.courbe{fill:none;stroke-width:2.2}
  .interferences .a{stroke:var(--oiii);fill:var(--oiii)}
  .interferences .b{stroke:var(--sodium);fill:var(--sodium)}
  .interferences .r{stroke:var(--halpha);fill:var(--halpha)}
  .interferences text.etiq{stroke:none;font-family:var(--mono);font-size:12px}
  .interferences :global(.cadre){fill:var(--nuit);stroke:var(--trait)}
  .interferences :global(.axe0){stroke:var(--doux);stroke-width:.8}
</style>

<script>
  import { fmt } from '../../lib/animation';
  const NS = 'http://www.w3.org/2000/svg';

  document.querySelectorAll<HTMLElement>('[data-interferences]').forEach((root) => {
    const q = <T extends Element>(s: string) => root.querySelector(s) as T;
    const inP = q<HTMLInputElement>('[data-phase]'), inA = q<HTMLInputElement>('[data-amp]'), inF = q<HTMLInputElement>('[data-freq]');
    // trois cadres : A (haut gauche), B (bas gauche), R (droite, échelle double)
    const cadres = [
      { x: 20, y: 30, w: 270, h: 120 }, { x: 20, y: 176, w: 270, h: 120 }, { x: 310, y: 30, w: 270, h: 266 },
    ];
    const g = q<SVGGElement>('[data-cadres]');
    for (const c of cadres) {
      const r = document.createElementNS(NS, 'rect');
      for (const [k, v] of Object.entries({ x: c.x, y: c.y, width: c.w, height: c.h, rx: 4, class: 'cadre' })) r.setAttribute(k, String(v));
      const l = document.createElementNS(NS, 'line');
      for (const [k, v] of Object.entries({ x1: c.x, x2: c.x + c.w, y1: c.y + c.h / 2, y2: c.y + c.h / 2, class: 'axe0' })) l.setAttribute(k, String(v));
      g.append(r, l);
    }
    const trace = (c: typeof cadres[0], ampMax: number, f: (x: number) => number) => {
      let d = '';
      for (let i = 0; i <= 240; i++) {
        const x = (2 * Math.PI * i) / 240, y = f(x);
        d += `${i ? 'L' : 'M'}${(c.x + (c.w * i) / 240).toFixed(1)} ${(c.y + c.h / 2 - (y / ampMax) * (c.h / 2 - 8)).toFixed(1)}`;
      }
      return d;
    };

    function dessine() {
      const phi = (+inP.value * Math.PI) / 180, a = +inA.value, k = +inF.value;
      const A = (x: number) => Math.sin(x), B = (x: number) => a * Math.sin(phi + k * x);
      q('[data-a]').setAttribute('d', trace(cadres[0], 1, A));
      q('[data-b]').setAttribute('d', trace(cadres[1], 1, B));
      q('[data-r]').setAttribute('d', trace(cadres[2], 2, (x) => A(x) + B(x)));
      q('[data-b-txt]').textContent = `B : y = ${fmt(a, 2)} sin(${inP.value}° + ${fmt(k, 2)} x)`;
      q('[data-phase-out]').textContent = `${inP.value}°`;
      q('[data-amp-out]').textContent = fmt(a, 2);
      q('[data-freq-out]').textContent = fmt(k, 2);
    }
    for (const el of [inP, inA, inF]) el.addEventListener('input', dessine);
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => {
      const [p, a, f] = b.dataset.preset!.split(','); inP.value = p; inA.value = a; inF.value = f; dessine();
    }));
    dessine();
  });
</script>
